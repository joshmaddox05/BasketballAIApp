{
  "cli": {
    "version": ">= 16.10.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_INFO_PLIST": "secret:GOOGLE_SERVICES_INFO_PLIST",
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON",
        "APP_ENV": "development"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium",
        "buildConfiguration": "Debug",
        "autoIncrement": false,
        "enterpriseProvisioning": "adhoc",
        "cache": {
          "key": "development-pods",
          "paths": [
            "ios/Pods"
          ]
        }
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "preview",
      "env": {
        "GOOGLE_SERVICES_INFO_PLIST": "secret:GOOGLE_SERVICES_INFO_PLIST",
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON",
        "YOUTUBE_API_KEY": "secret:YOUTUBE_API_KEY",
        "APP_ENV": "preview",
        "SENTRY_DSN": "secret:SENTRY_DSN",
        "SENTRY_ORG": "secret:SENTRY_ORG",
        "SENTRY_PROJECT": "secret:SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN": "secret:SENTRY_AUTH_TOKEN",
        "POSTHOG_API_KEY": "secret:POSTHOG_API_KEY",
        "POSTHOG_HOST": "secret:POSTHOG_HOST"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-internal": {
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_INFO_PLIST": "secret:GOOGLE_SERVICES_INFO_PLIST",
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON",
        "YOUTUBE_API_KEY": "secret:YOUTUBE_API_KEY",
        "APP_ENV": "preview",
        "SENTRY_DSN": "secret:SENTRY_DSN",
        "SENTRY_ORG": "secret:SENTRY_ORG",
        "SENTRY_PROJECT": "secret:SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN": "secret:SENTRY_AUTH_TOKEN",
        "POSTHOG_API_KEY": "secret:POSTHOG_API_KEY",
        "POSTHOG_HOST": "secret:POSTHOG_HOST"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_INFO_PLIST": "secret:GOOGLE_SERVICES_INFO_PLIST",
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON",
        "APP_ENV": "preview"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "GOOGLE_SERVICES_INFO_PLIST": "secret:GOOGLE_SERVICES_INFO_PLIST",
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON",
        "STRIPE_PUBLISHABLE_KEY": "secret:STRIPE_PUBLISHABLE_KEY",
        "YOUTUBE_API_KEY": "secret:YOUTUBE_API_KEY",
        "API_BASE_URL": "secret:API_BASE_URL",
        "APP_ENV": "production",
        "SENTRY_DSN": "secret:SENTRY_DSN",
        "SENTRY_ORG": "secret:SENTRY_ORG",
        "SENTRY_PROJECT": "secret:SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN": "secret:SENTRY_AUTH_TOKEN",
        "POSTHOG_API_KEY": "secret:POSTHOG_API_KEY",
        "POSTHOG_HOST": "secret:POSTHOG_HOST"
      }
    }
  },
  "submit": {
    "production": {},
    "preview": {}
  }
}
