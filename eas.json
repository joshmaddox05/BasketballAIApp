{
  "cli": {
    "version": ">= 16.10.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "jsEngine": "hermes"
      },
      "android": {
        "buildType": "apk",
        "jsEngine": "hermes"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "jsEngine": "hermes"
      },
      "android": {
        "buildType": "apk",
        "jsEngine": "hermes"
      }
    },
    "preview-simulator": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "jsEngine": "hermes"
      },
      "android": {
        "buildType": "apk",
        "jsEngine": "hermes"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "jsEngine": "hermes"
      },
      "android": {
        "jsEngine": "hermes"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
