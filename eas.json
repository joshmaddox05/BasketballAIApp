{
  "cli": {
    "version": ">= 16.10.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_INFO_PLIST": "secret:GOOGLE_SERVICES_INFO_PLIST",
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium",
        "buildConfiguration": "Debug",
        "autoIncrement": false,
        "enterpriseProvisioning": "adhoc",
        "cache": {
          "key": "development-pods",
          "paths": ["ios/Pods"]
        }
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_INFO_PLIST": "secret:GOOGLE_SERVICES_INFO_PLIST",
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_INFO_PLIST": "secret:GOOGLE_SERVICES_INFO_PLIST",
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GOOGLE_SERVICES_INFO_PLIST": "secret:GOOGLE_SERVICES_INFO_PLIST",
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON"
      }
    }
  },
  "submit": {
    "production": {},
    "preview": {}
  }
}
