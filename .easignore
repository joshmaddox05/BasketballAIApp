# EAS Build Ignore File
# Files and directories to exclude from EAS builds

# Node modules (installed during build)
node_modules/

# iOS build artifacts (generated during build)
ios/Pods/
ios/build/
ios/**/*.xcworkspace/xcuserdata/
ios/**/*.xcodeproj/xcuserdata/
ios/**/*.xcodeproj/project.xcworkspace/xcuserdata/

# Android build artifacts
android/app/build/
android/build/
android/.gradle/

# Expo
.expo/
.expo-shared/

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Firebase emulator data
firestore-debug.log
ui-debug.log
firebase-debug.log
emulator-data/

# Local env files (secrets should be in EAS)
.env.local
.env.development.local
.env.test.local
.env.production.local
