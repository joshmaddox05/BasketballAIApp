rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection - users can only access their own data
    match /users/{uid} {
      allow read: if isSignedIn() && isOwner(uid);
      allow create: if isSignedIn() && isOwner(uid);
      allow update, delete: if isSignedIn() && isOwner(uid);
      
      // User's activities (ADDED - this was missing!)
      match /activities/{activityId} {
        allow read, write: if isSignedIn() && isOwner(uid);
      }
      
      // User's workout plans
      match /plans/{planId} {
        allow read, write: if isSignedIn() && isOwner(uid);
      }
      
      // User's training sessions
      match /sessions/{sessionId} {
        allow read, write: if isSignedIn() && isOwner(uid);
      }
      
      // User's goals
      match /goals/{goalId} {
        allow read, write: if isSignedIn() && isOwner(uid);
      }
      
      // User's achievements
      match /achievements/{achievementId} {
        allow read, write: if isSignedIn() && isOwner(uid);
      }
    }
    
    // Workout templates - public read, admin write only
    match /workoutTemplates/{templateId} {
      allow read: if true; // Public templates
      allow write: if false; // Lock down for now - admin only
    }
    
    // Exercise definitions - public read, admin write only
    match /exercises/{exerciseId} {
      allow read: if true; // Public exercises
      allow write: if false; // Lock down for now - admin only
    }
    
    // Global content collections
    match /workouts/{workoutId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin only
    }
    
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin only
    }
    
    // Community features
    match /community/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isOwner(resource.data.userId);
      
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && isOwner(resource.data.userId);
      }
    }
  }
}