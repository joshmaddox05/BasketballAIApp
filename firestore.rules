rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // DEVELOPMENT MODE: Temporarily open for testing
    // TODO: Tighten these rules before production!
    // Users collection - temporarily open for development
    match /users/{uid} {
      allow read, write: if true; // DEVELOPMENT ONLY - CHANGE BEFORE PRODUCTION!
      
      // User's subcollections - temporarily open for development
      match /activities/{activityId} {
        allow read, write: if true; // DEVELOPMENT ONLY
      }

      match /plans/{planId} {
        allow read, write: if true; // DEVELOPMENT ONLY
      }

      match /sessions/{sessionId} {
        allow read, write: if true; // DEVELOPMENT ONLY
      }

      match /goals/{goalId} {
        allow read, write: if true; // DEVELOPMENT ONLY
      }

      match /achievements/{achievementId} {
        allow read, write: if true; // DEVELOPMENT ONLY
      }
    }
    
    // Workout templates - public read, admin write only
    match /workoutTemplates/{templateId} {
      allow read: if true; // Public templates
      allow write: if false; // Lock down for now - admin only
    }
    
    // Exercise definitions - public read, admin write only
    match /exercises/{exerciseId} {
      allow read: if true; // Public exercises
      allow write: if false; // Lock down for now - admin only
    }
    
    // Global content collections - DEVELOPMENT MODE
    match /workouts/{workoutId} {
      allow read, write: if true; // DEVELOPMENT ONLY - CHANGE BEFORE PRODUCTION!
    }

    match /videos/{videoId} {
      allow read, write: if true; // DEVELOPMENT ONLY - CHANGE BEFORE PRODUCTION!
    }
    
    // Community features
    match /community/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isOwner(resource.data.userId);
      
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && isOwner(resource.data.userId);
      }
    }
  }
}