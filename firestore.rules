rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Users collection - users can only read/write their own data
    match /users/{uid} {
      // Users can read their own profile, and basic info of other users
      allow read: if isSignedIn();
      // Users can only create/update their own profile
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false; // Prevent accidental deletion

      // User's activities - only owner can access
      match /activities/{activityId} {
        allow read, write: if isOwner(uid);
      }

      // User's training plans - only owner can access
      match /plans/{planId} {
        allow read, write: if isOwner(uid);
      }

      // User's training sessions - only owner can access
      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      // User's goals - only owner can access
      match /goals/{goalId} {
        allow read, write: if isOwner(uid);
      }

      // User's achievements - only owner can access
      match /achievements/{achievementId} {
        allow read, write: if isOwner(uid);
      }

      // User's custom workouts - only owner can access
      match /customWorkouts/{workoutId} {
        allow read, write: if isOwner(uid);
      }

      // User's custom plans - only owner can access
      match /customPlans/{planId} {
        allow read, write: if isOwner(uid);
      }

      // Challenge progress - only owner can read/write
      match /challengeProgress/{challengeId} {
        allow read, write: if isOwner(uid);
      }

      // Daily challenge progress - only owner can access
      match /dailyChallengeProgress/{progressId} {
        allow read, write: if isOwner(uid);
      }

      // Challenge invites - owner can read/write, any authenticated user can create
      match /challengeInvites/{inviteId} {
        allow read: if isOwner(uid);
        allow create: if isSignedIn();
        allow update, delete: if isOwner(uid);
      }

      // Friends list - only owner can manage
      match /friends/{friendUid} {
        allow read: if isOwner(uid) || isOwner(friendUid);
        allow write: if isOwner(uid);
      }

      // Friend requests - owner can read/manage, any authenticated user can create
      match /friendRequests/{requestId} {
        allow read: if isOwner(uid);
        allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
        allow update, delete: if isOwner(uid);
      }
    }

    // Workout templates - public read, admin write only
    match /workoutTemplates/{templateId} {
      allow read: if true;
      allow write: if false; // Admin only via Firebase Console or Cloud Functions
    }

    // Exercise definitions - public read, admin write only
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Global workouts - public read, admin write only
    match /workouts/{workoutId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Videos - public read, admin write only
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Challenges collection - public read, admin write only
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if false; // Admin only - seeded via scripts
    }

    // Daily challenges - public read, admin write only
    match /dailyChallenges/{challengeId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Daily challenge templates - public read, admin write only
    match /dailyChallengeTemplates/{templateId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Challenge leaderboards - readable by all, writable by authenticated participants
    match /challengeLeaderboards/{challengeId} {
      allow read: if true;

      match /entries/{entryId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }

    // Community posts - authenticated users only
    match /community/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }

      match /likes/{likeId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && likeId == request.auth.uid;
      }
    }

    // User challenges (joined challenges) - users can read their own and update progress
    match /userChallenges/{challengeInstanceId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false; // Keep history
    }
  }
}
